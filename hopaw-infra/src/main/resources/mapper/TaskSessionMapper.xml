<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agent.hopaw.infra.mapper.TaskSessionMapper">

    <resultMap id="TaskSessionResultMap" type="com.agent.hopaw.infra.model.entity.TaskSession">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="allColumns">
        id, task_id, session_id, create_time
    </sql>

    <insert id="insert">
        INSERT INTO task_sessions (task_id, session_id)
        VALUES (#{taskId}, #{sessionId})
    </insert>

    <select id="findByTaskId" resultMap="TaskSessionResultMap">
        SELECT <include refid="allColumns"/>
        FROM task_sessions
        WHERE task_id = #{taskId}
        ORDER BY id ASC
    </select>

    <select id="findTaskIdBySessionId" resultType="long">
        SELECT task_id FROM task_sessions WHERE session_id = #{sessionId} LIMIT 1
    </select>

    <delete id="deleteByTaskId">
        DELETE FROM task_sessions WHERE task_id = #{taskId}
    </delete>

</mapper>

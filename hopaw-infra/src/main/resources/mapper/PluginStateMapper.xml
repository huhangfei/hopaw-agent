<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agent.hopaw.infra.mapper.PluginStateMapper">

    <resultMap id="PluginStateResultMap" type="com.agent.hopaw.infra.model.entity.PluginState">
        <id property="pluginId" column="plugin_id"/>
        <result property="enabled" column="enabled"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="allColumns">
        plugin_id, enabled, update_time
    </sql>

    <select id="findAll" resultMap="PluginStateResultMap">
        SELECT <include refid="allColumns"/>
        FROM plugin_state
    </select>

    <select id="findByPluginId" resultMap="PluginStateResultMap">
        SELECT <include refid="allColumns"/>
        FROM plugin_state
        WHERE plugin_id = #{pluginId}
    </select>

    <insert id="upsert" parameterType="com.agent.hopaw.infra.model.entity.PluginState">
        INSERT INTO plugin_state (plugin_id, enabled, update_time)
        VALUES (#{pluginId}, #{enabled}, datetime('now', 'localtime'))
        ON CONFLICT(plugin_id) DO UPDATE SET
            enabled = #{enabled},
            update_time = datetime('now', 'localtime')
    </insert>

    <delete id="deleteByPluginId">
        DELETE FROM plugin_state WHERE plugin_id = #{pluginId}
    </delete>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agent.hopaw.infra.mapper.TaskSessionMapper">

    <resultMap id="TaskSessionResultMap" type="com.agent.hopaw.infra.model.entity.TaskSession">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="createTime" column="create_time"/>
        <result property="title" column="title"/>
    </resultMap>

    <sql id="allColumns">
        id, task_id, session_id, create_time
    </sql>

    <insert id="insert">
        INSERT INTO task_sessions (task_id, session_id, create_time)
        VALUES (#{taskId}, #{sessionId}, datetime('now','localtime'))
    </insert>

    <select id="findByTaskId" resultMap="TaskSessionResultMap">
        SELECT ts.id, ts.task_id, ts.session_id, ts.create_time, cs.title
        FROM task_sessions ts
        LEFT JOIN chat_sessions cs ON ts.session_id = cs.session_id
        WHERE ts.task_id = #{taskId}
        ORDER BY ts.id ASC
    </select>

    <select id="findTaskIdBySessionId" resultType="long">
        SELECT task_id FROM task_sessions WHERE session_id = #{sessionId} LIMIT 1
    </select>

    <delete id="deleteByTaskId">
        DELETE FROM task_sessions WHERE task_id = #{taskId}
    </delete>

</mapper>

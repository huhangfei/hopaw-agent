<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agent.hopaw.infra.mapper.IpBlacklistMapper">

    <resultMap id="IpBlacklistResultMap" type="com.agent.hopaw.infra.model.entity.IpBlacklist">
        <id property="id" column="id"/>
        <result property="ip" column="ip"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findAll" resultMap="IpBlacklistResultMap">
        SELECT id, ip, remark, create_time
        FROM ip_blacklist
        ORDER BY id DESC
    </select>

    <select id="findByIp" resultMap="IpBlacklistResultMap">
        SELECT id, ip, remark, create_time
        FROM ip_blacklist
        WHERE ip = #{ip}
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.agent.hopaw.infra.model.entity.IpBlacklist">
        INSERT INTO ip_blacklist (ip, remark)
        VALUES (#{ip}, #{remark})
        <selectKey resultType="long" keyProperty="id" order="AFTER">
            SELECT last_insert_rowid()
        </selectKey>
    </insert>

    <delete id="deleteById">
        DELETE FROM ip_blacklist WHERE id = #{id}
    </delete>

    <select id="countAll" resultType="int">
        SELECT COUNT(1) FROM ip_blacklist
    </select>

</mapper>

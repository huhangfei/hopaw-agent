<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agent.hopaw.infra.mapper.TaskAttachmentMapper">

    <resultMap id="TaskAttachmentResultMap" type="com.agent.hopaw.infra.model.entity.TaskAttachment">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="attachmentId" column="attachment_id"/>
        <result property="createTime" column="create_time"/>
        <result property="originalName" column="original_name"/>
        <result property="fileType" column="file_type"/>
        <result property="url" column="url"/>
    </resultMap>

    <sql id="allColumns">
        id, task_id, attachment_id, create_time
    </sql>

    <insert id="insert">
        INSERT INTO task_attachments (task_id, attachment_id)
        VALUES (#{taskId}, #{attachmentId})
    </insert>

    <delete id="deleteByTaskIdAndAttachmentId">
        DELETE FROM task_attachments WHERE task_id = #{taskId} AND attachment_id = #{attachmentId}
    </delete>

    <select id="findByTaskId" resultMap="TaskAttachmentResultMap">
        SELECT ta.id, ta.task_id, ta.attachment_id, ta.create_time,
               a.original_name, a.file_type, a.url
        FROM task_attachments ta
        LEFT JOIN attachments a ON a.id = ta.attachment_id
        WHERE ta.task_id = #{taskId}
        ORDER BY ta.id ASC
    </select>

    <delete id="deleteByTaskId">
        DELETE FROM task_attachments WHERE task_id = #{taskId}
    </delete>

</mapper>

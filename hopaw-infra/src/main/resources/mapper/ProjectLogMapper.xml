<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agent.hopaw.infra.mapper.ProjectLogMapper">

    <resultMap id="ProjectLogResultMap" type="com.agent.hopaw.infra.model.entity.ProjectLog">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="action" column="action"/>
        <result property="detail" column="detail"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.agent.hopaw.infra.model.entity.ProjectLog">
        INSERT INTO project_logs (project_id, operator_id, operator_name, action, detail)
        VALUES (#{projectId}, #{operatorId}, #{operatorName}, #{action}, #{detail})
        <selectKey resultType="long" keyProperty="id" order="AFTER">
            SELECT last_insert_rowid()
        </selectKey>
    </insert>

    <select id="findByProjectId" resultMap="ProjectLogResultMap">
        SELECT id, project_id, operator_id, operator_name, action, detail, create_time
        FROM project_logs
        WHERE project_id = #{projectId}
        ORDER BY id ASC
    </select>

</mapper>

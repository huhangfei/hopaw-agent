      "pages": ["index"],
      "mount": "body",
      "mode": "append",
      "priority": 1000
    },
    {
      "id": "chat-beautify-css",
      "type": "css",
      "path": "static/chat-beautify.css",
      "pages": ["index"],
      "priority": 1000
    },
    {
      "id": "chat-beautify-js",
      "type": "js",
      "path": "static/chat-beautify.js",
